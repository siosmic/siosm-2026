{
	"name": "siosm-tailwind",
	"version": "1.0.0",
	"description": "SIOSM WordPress theme",
	"author": "siosm",
	"repository": {
		"type": "git",
		"url": ""
	},
	"theme_uri": "",
	"author_uri": "https://siosm.ch",
	"text_domain": "siosm-tailwind",
	"license": "GPL-2.0",
	"scripts": {
		"dev": "concurrently \"tailwindcss -i ./app/css/app.css -o ./build/css/app.css --postcss --watch\" \"tailwindcss -i ./app/css/editor-style.css -o ./build/css/editor-style.css --postcss --watch\" \"wp-scripts start\" \"cross-env NODE_ENV=development browser-sync start --https --proxy \\\"infobat.local\\\" --host=\\\"infobat.local\\\" --no-inject-changes --no-notify --files=\\\"./\\\"\"",
		"build": "concurrently \"tailwindcss -i ./app/css/app.css -o ./build/css/app.css --postcss --minify\" \"tailwindcss -i ./app/css/editor-style.css -o ./build/css/editor-style.css --postcss --minify\" \"wp-scripts build\"",
		"export": "npm run build && node export.js"
	},
	"devDependencies": {
		"@tailwindcss/forms": "^0.4.0",
		"@wordpress/scripts": "^32.4.0",
		"autoprefixer": "^10.4.2",
		"browser-sync": "^3.0.4",
		"concurrently": "^6.2.1",
		"cross-env": "^6.0.3",
		"esbuild": "^0.25.5",
		"postcss": "^8.2.10",
		"postcss-import": "^14.0.0",
		"postcss-nested": "^5.0.3",
		"postcss-nested-ancestors": "^3.0.0",
		"prettier": "^2.5.1",
		"prettier-plugin-tailwindcss": "^0.1.5",
		"resolve-url-loader": "^5.0.0",
		"tailwindcss": "^3.0.15"
	},
	"dependencies": {
		"lodash": "^4.17.21"
	}
}